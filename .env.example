# LiveKit Cloud connection (required)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model providers (required)
# Groq: STT (whisper-large-v3-turbo), LLM (qwen3.6-27b), TTS fallback (Orpheus)
GROQ_API_KEY=
# Cartesia: primary TTS
CARTESIA_API_KEY=
# Anam: avatar. Optional - agent falls back to voice+text if this fails
ANAM_API_KEY=

# Optional avatar overrides (defaults are set in src/agent.py)
ANAM_AVATAR_NAME=
ANAM_AVATAR_ID=
